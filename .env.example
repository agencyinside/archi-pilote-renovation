# ============================================================
# Variables d'environnement — copier en .env.local pour un test
# en local. Ce fichier-ci est versionné, .env.local ne l'est pas.
# En production, ces valeurs vivent dans les secrets GitHub Actions
# (Settings → Secrets and variables → Actions).
# ============================================================

# Clé d'API Sedestral. Jamais préfixée NEXT_PUBLIC_ : elle ne doit
# jamais partir dans le bundle envoyé au navigateur.
SEDESTRAL_API_KEY=

# Origine publique du site, sans slash final. Sert à construire l'URL
# renvoyée à Sedestral et à vérifier la mise en ligne avant confirmation.
SITE_ORIGIN=https://www.archipiloterenovation.com

# Optionnels
# SEDESTRAL_API_BASE=https://api.sedestral.com/api/v1
# SEDESTRAL_DEFAULT_CATEGORY=Rénovation
# SEDESTRAL_DEPLOY_TIMEOUT_MS=900000

# Clé d'API WhatsWrong (synchronisation scripts/whatswrong-sync.mjs).
# En production : secret GitHub Actions WW_API_KEY. Jamais préfixée NEXT_PUBLIC_.
WW_API_KEY=
